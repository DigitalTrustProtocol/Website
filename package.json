{
  "name": "dtp-website",
  "private": true,
  "version": "0.1.0",
  "description": "Public website of the Digital Trust Protocol",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "content:sync": "tsx scripts/content-sync.ts",
    "content:build": "tsx scripts/content-build.ts",
    "prebuild": "npm run content:build",
    "build": "react-router build && vite build --config vite.enhance.config.ts && tsx scripts/postbuild.ts",
    "preview": "tsx scripts/preview.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-router/node": "^7.18.4",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "mermaid": "~11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^7.18.4",
    "@shikijs/rehype": "^4.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "github-slugger": "^2.0.0",
    "happy-dom": "^20.14.5",
    "hast-util-to-string": "^3.0.1",
    "oxlint": "^1.86.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
